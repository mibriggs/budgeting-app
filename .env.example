# Drizzle
# Local: file:local.db (no token). Production: your Turso URL, e.g. libsql://budget-you.turso.io
DATABASE_URL=file:local.db
# Turso auth token (production only; leave empty locally)
DATABASE_AUTH_TOKEN=""

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
